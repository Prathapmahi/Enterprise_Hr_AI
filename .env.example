# Enterprise HR AI System — Environment Configuration
# Copy this to .env and adjust as needed
# NO API KEYS REQUIRED — all models run locally

# ── App ───────────────────────────────────────────────
APP_NAME=Enterprise HR AI System
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ── Local LLM (Ollama) — No API key needed ────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
# Alternatives: mistral, phi3, gemma2, codellama
USE_OLLAMA=true

# ── Database ──────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./hr_ai.db

# ── RAG Settings ──────────────────────────────────────
RAG_TOP_K=3
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Risk Thresholds ───────────────────────────────────
ATTRITION_HIGH_RISK=0.65
BURNOUT_CRITICAL=0.75
OVERTIME_LIMIT_WEEKLY=60
